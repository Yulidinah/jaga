PORT=3000
NODE_ENV=development

# --- Supabase (wajib di produksi)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Kunci publik (anon/publishable) dipakai untuk login Supabase Auth; bila kosong dipakai secret key.
SUPABASE_ANON_KEY=

# --- Sesi
# Wajib diisi (string acak panjang) agar sesi tetap valid setelah restart / banyak instance.
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
# Cookie selalu Secure bila NODE_ENV=production; set true untuk HTTPS lain.
SECURE_COOKIE=false

# Perangkat dianggap offline bila tidak mengirim sinyal selama sekian menit.
DEVICE_OFFLINE_MINUTES=15

# Isi true bila database Supabase berisi data dummy; dashboard menampilkan label "Data dummy".
JAGA_DATA_IS_DUMMY=false

# --- Mode pengembangan (JANGAN dipakai di produksi)
# Paksa penyimpanan memori + data demo (akun demo berkata sandi publik).
JAGA_FORCE_MEMORY=false
# Hanya untuk demo di Supabase tanpa kalung asli: menjaga kalung data contoh tetap tampil online. Jangan aktif bersama kalung sungguhan.
JAGA_DEMO_HEARTBEAT=false
# Izinkan beralih ke memori bila Supabase tidak terjangkau.
JAGA_ALLOW_MEMORY_FALLBACK=false
# Izinkan header X-JAGA-Role tanpa token (hanya demo lokal; tanpa kredensial).
JAGA_DEV_ROLE_HEADER=false

# Dipakai pada tahap integrasi gateway, jangan ditanam di firmware kalung.
MQTT_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=jaga-backend
MQTT_PASSWORD=replace-me

# Notifikasi (opsional). Twilio aktif untuk SMS; FCM HTTP v1 belum diintegrasikan.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Lapisan peta risiko InaRISK (opsional; kosongkan bila tidak dipakai)
INARISK_WMS_URL=
INARISK_WMS_LAYERS=
